{
  "name": "archil-sandbox-desktop",
  "version": "0.1.0",
  "description": "A VNC virtual desktop (XFCE + noVNC) for Archil sandboxes",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "archil-desktop": "dist/cli.js"
  },
  "files": [
    "dist",
    "image"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "archil",
    "sandbox",
    "vnc",
    "novnc",
    "desktop",
    "computer-use"
  ],
  "dependencies": {
    "disk": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
